# Copie ce fichier en .env et remplis chaque valeur

# 1. Token Telegram — obtenu via @BotFather sur Telegram
TELEGRAM_TOKEN=

# 2. Clé API Google Gemini — GRATUIT sur aistudio.google.com
GEMINI_API_KEY=

# 3. Ton ID Telegram perso — obtenu via @userinfobot sur Telegram
#    Sert à bloquer l'accès aux inconnus (sécurité)
OWNER_TELEGRAM_ID=

# 4. Infos entreprise (à remplir après immatriculation)
SIRET=
BUSINESS_EMAIL=contact@ak-reseaux-batiment.fr
BUSINESS_PHONE=
BUSINESS_ADDRESS=
ASSURANCE_RC=
